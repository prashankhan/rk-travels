# Public production URL, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Resend (https://resend.com). Server-only. Leave empty until the sending domain is verified.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "R.K Travels <enquiries@your-domain>"
ENQUIRY_FROM_EMAIL=
# Inbox that receives enquiries (the business address, once confirmed)
ENQUIRY_TO_EMAIL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
